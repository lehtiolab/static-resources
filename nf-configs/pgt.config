/* ENSEMBL file mapping for references */

params.file_organism = {params.organism ? [mouse: 'Mus_musculus', human: 'Homo_sapiens'][params.organism] : null}.call()

params.grc_version = {params.organism && params.ensembl_release ? 
    [mouse: [
      '101': 'm38',
      '102': 'm38',
      '103': 'm39',
      '104': 'm39',
      '105': 'm39',
      '106': 'm39',
      '107': 'm39',
      '108': 'm39',
      '109': 'm39',
      '110': 'm39',
      '111': 'm39',
      '112': 'm39',
      '113': 'm39',
      '114': 'm39',
      '115': 'm39',
    ],
    human: [
       '75': 'h37',
      '111': 'h38',
      '112': 'h38',
      '113': 'h38',
      '114': 'h38',
      '115': 'h38',
    ]][params.organism][params.ensembl_release] : null}.call()

// DBGen and identify
params.refgtf = {params.grc_version ? "${params.bigdata_file_path}/ensembl_ref/${params.file_organism}.GRC${params.grc_version}.${params.ensembl_release}.gtf" : null}.call()

// DBGen
params.genome = {params.grc_version ? "${params.bigdata_file_path}/ensembl_ref/${params.file_organism}.GRC${params.grc_version}.dna_sm.primary_assembly.fa" : null}.call()
  
// Identify
params.canonical_peps = {params.grc_version ? "${params.data_file_path}/ENS${params.ensembl_release}_${params.file_organism}.fa" : null}.call()
  
// Prefix fromm canonical DB
params.known_prefixes = {params.organism ? [mouse: 'ENSMUSP', human: 'ENSP'][params.organism] : null}
  params.crosscheck_known_prefixes = {params.organism ? [mouse: 'ENSMUSP', human: 'ENSP'][params.organism] : null}.call()
