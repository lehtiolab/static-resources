includeConfig "https://raw.githubusercontent.com/lehtiolab/static-resources/main/nf-configs/lehtio.config"

params {
  batchsize = 1
}

process {
  cpus = 10
  
  withName: predictFastaLibrary {
    // Either 200 * lib size, or 16GB whatever is bigger
    memory = { Math.max(fasta.collect { it.size() }.sum() * 200, 16L << 30) * 1.B }
  }

  withName: searchWithPredictedLib {
    time = { raws.size() * 3.h }
    // biggest raw times 4, or 16.GB
    memory = { Math.max(raws.collect { it.isDirectory() ? it.toRealPath().eachFileMatch('analysis.tdf_bin') { it.size() }[0] : it.size() }.max() * 4, 16L << 30) * 1.B } 
  }

  withName: combineEmpiricalLibraryRuns  {
    memory = { Math.max(raws.collect { it.isDirectory() ? it.toRealPath().eachFileMatch('analysis.tdf_bin') { it.size()/20 }[0] : it.size()/20 }.sum().longValue() , 16L << 30) * 1.B } 
  }

  withName: RunDiaAnalysis {
    // biggest raw times 4, or 16.GB
    memory = { Math.max(raws.collect { it.isDirectory() ? it.toRealPath().eachFileMatch('analysis.tdf_bin') { it.size() }[0] : it.size() }.max() * 4, 16L << 30) * 1.B } 
  }

  withName: TrainQuantUMS {
    memory = { Math.max(raws.collect { it.isDirectory() ? it.toRealPath().eachFileMatch('analysis.tdf_bin') { it.size() }[0] : it.size() }.max() * 10, 16L << 30) * 1.B } 
  }

  withName: DiaQuantificationReport {
    memory = { Math.max(raws.collect { it.isDirectory() ? it.toRealPath().eachFileMatch('analysis.tdf_bin') { it.size() }[0] : it.size() }.max() * 10, 16L << 30) * 1.B } 
  }

  withName: logConcat {
    cpus = 1
  }
}
