includeConfig "https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/naiss.config"

process {
  withName: createNewSpectraLookup {
    time = { mzmlfiles.size() > 100 ? 0.02.h * mzmlfiles.size() * task.attempt : 2.h * task.attempt}
//    memory = { mzmlfiles.size() > 300 ? 60.MB * mzmlfiles.size() * task.attempt : 16.GB * task.attempt}
  }
  withName: quantifySpectra {
    memory = { (infile.size() >> 30) > 5 ? infile.size() * 4 as nextflow.util.MemoryUnit : '16 GB'}
    time = { 1.h * (infile.size() >> 30) * task.attempt }
  }
  withName: quantifyMS1 {
    cpus = 4
  }
  withName: msgfPlus {
    cpus = { (db.size() >> 30) < 1 ? 16 : (db.size() >> 30) * 16  }
    memory = { (db.size() >> 30) < 1 ? 16.GB : "${db.size() * 16}B"  }
    time = { (mzml.size() >> 30) < 1 ? 3.h * task.attempt : (3 + (mzml.size() >> 30)) * task.attempt * 1.h }
    // Also put 255 for "context deadline exceeded" in retry list
    errorStrategy = { task.exitStatus in [140, 137, 255] ? 'retry': 'terminate' }
  }
  withName: sage {
    cpus = { (db.size() >> 30) < 1 ? 32 : (db.size() >> 30) * 32  }
    memory = { (db.size() >> 30) < 2 ? 32.GB : "${db.size() * 16}B"  }
    time = { (mzml.size() >> 30) < 1 ? 1.h * task.attempt : (2 + (mzml.size() >> 30)) * task.attempt * 1.h }
  }
  withName: quantLookup {
    time = { 0.1.h * isofns.size() * task.attempt }
    memory = { isofns.size() > 256 ? isofns.size() * 96.MB * task.attempt : 16.GB * task.attempt }
  }

  withName: createPSMTable {
    // lookup size is a proxy for amount of PSMs
    time = { (lookup.size() >> 30) > 28 ? 0.07.h * (lookup.size() >> 30) * task.attempt : 2.h * task.attempt }
    // protein grouping needs memory if there's lots of information
    memory = { (lookup.size() >> 30) < 8 ? task.attempt * 16.GB : task.attempt * lookup.size() * 2.B * (params.noquant || params.noisoquant ? 2 : 1)}
  }

  withName: percolatorForMsgf {
    time = { mzids.size() > 40 ? 0.1.h * mzids.size() * task.attempt : 4.h * task.attempt }
    cpus = 4
  }
  withName: percolatorForSage {
    time = { pins.size() > 40 ? 0.1.h * pins.size() * task.attempt : 4.h * task.attempt }
    cpus = 4
  }
  withName: DEqMS {
    cpus = 16
  }

  withName: luciphorPTMLocalizationScoring {
    time = { (allpsms.size() >> 20) * 0.0067.h * task.attempt }
    cpus = 2
  }
  
  withName: msconvert {
    time = 5.h
  }

  withName: proteinPeptideSetMerge {
    // lookup size is a proxy for amount of PSMs
    time = { (lookup.size() >> 30) > 20 ? 0.1.h * (lookup.size() >> 30) * task.attempt : 2.h * task.attempt }
    //memory = { (lookup.size() >> 30) < 12 ? task.attempt * 16.GB : task.attempt * (lookup.size() >> 30) * 1.5.GB }
  }

  withName: featQC {
    time = { (peptable.size() >> 20) > 250 ? task.attempt * (peptable.size() >> 20) * 0.008.h : task.attempt * 2.h }
    memory = { (peptable.size() >> 20) > 512 ? task.attempt * peptable.size() * 512.B : task.attempt * 16.GB}
  }
}
