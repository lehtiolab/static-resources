includeConfig "https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/naiss.config"


params {
  cachedir = { "${System.getenv('PWD')}/../../../__spectronaut_cache" }.call()

  // For license dirs and batch size calculation, we need the nodes
  nodelist = {
    def nl = [ 
      // cpu partitiion, 128 cores, 768GB RAM
      'n213', 'n214', 'n215', 'n216', 'n217', 'n218', 'n219', 'n220', 'n221', 'n222',
      'n223', 'n224', 'n225', 'n226', 'n227', 'n228', 'n229', 'n230', 'n231', 'n232', 'n233',

      // fat partition, 128 cores, 3TB RAM
      'n13', 'n14', 'n15', 'n16',
    ]
  nl.join(',')
  }.call()

}

// Always overbook half a node with cpus=130,
// so we cannot run multiple processes on a single node.
// This is done because that is incompatible with license, program will crash
// memory may need some trying and tuning, depend on file size, batch size? 
process {
  // For SLURM we need clusterOptions, unfortunately with strict syntax we cannot reuse the nodelist from above, so rewrite it here
  clusterOptions = {
    def nl = [
      // cpu partitiion, 128 cores, 768GB RAM
      'n213', 'n214', 'n215', 'n216', 'n217', 'n218', 'n219', 'n220', 'n221', 'n222',
      'n223', 'n224', 'n225', 'n226', 'n227', 'n228', 'n229', 'n230', 'n231', 'n232', 'n233',

      // fat partition, 128 cores, 3TB RAM
      'n13', 'n14', 'n15', 'n16',
    ]
  "-n 1 --nodelist=${nl.join(',')}"
  }.call()

  withName: activateLicense {
    time = 0.1.h
    cpus = 1
  }
  withName: generateLibrary {
    cpus = 65
    memory = {raws.size() > 10 ? 150.GB + 2.GB * raws.size() * task.attempt : 150.GB * task.attempt}
    time = {raws.size() > 3 ? 1.h * raws.size() * task.attempt : 2.h * task.attempt}
  }

  withName: mergePsar {
   // depend on size but 30 libraries TIMS data took only 60GB
    cpus = 65
    memory = {230.GB * task.attempt} 
    time = { (psar_size_total >> 30) > 4 ? (psar_size_total >> 30) * 0.5.h * task.attempt : 2.h * task.attempt }
  }

  withName: searchDIA {
    cpus = 65
    // It works with e.g. 100GB, but it gets slower due to memory constraint and wont max out CPU usage
    memory = {raws.size() > 10 ? 150.GB + 2.GB * raws.size() * task.attempt : 150.GB * task.attempt }
    time = {raws.size() > 2 ? 1.h * raws.size() * task.attempt : 2.h * task.attempt}
  }

  withName: recalculateSNE {
// totalsize variable can be used here for memory!
    cpus = 65
    memory = 400.GB
  }

  withName: generateConditionFile {
    time = 0.1.h
    cpus = 1
  }
  withName: extractThermoScans {
    time = 0.1.h
    cpus = 1
  }
  withName: getBrukerScanNumbers {
    time = 0.1.h
    cpus = 1
  }
  withName: precursorPlot {
    time = 4.h
    cpus = 1
  }
  withName: proteinPlot {
    time = 4.h
    cpus = 1
  }
  withName: summaryReport {
    time = 0.1.h
    cpus = 1
  }
}

workflow {
  output {
    mode = 'copy'
  }
}
