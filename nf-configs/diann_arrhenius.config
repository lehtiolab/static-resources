includeConfig "https://raw.githubusercontent.com/nf-core/configs/refs/heads/master/conf/naiss.config"

params {
  batchsize = 1
}

process {
  cpus = 1
  errorStrategy = { task.exitStatus in [140, 137] ? 'retry': 'terminate' }
  maxRetries = 3
  
  withName: predictFastaLibrary {
    // Either 200 * lib size, or 16GB whatever is bigger
    memory = { Math.max(fasta.collect { it.size() }.sum() * 200, 16L << 30) * 1.B }
    cpus = 10
  }

  withName: searchWithPredictedLib {
    time = { raws.size() * 6.h }
    // biggest raw times 4, or 16.GB
    memory = { Math.max(raws.collect { it.isDirectory() ? it.toRealPath().listFiles().find { it=~/analysis.tdf_bin/ } : it}.collect { it.size() }.max() * 10, 16L << 30) * 1.B } 
    cpus = 10
  }

  withName: combineEmpiricalLibraryRuns  {
    // sum raws, divide by 20, set that as memory, if bigger than 16G
    // need to convert to long for Math.max(long, long) or it will error w ambiguous method overload
    memory = { Math.max(raws.collect { it.isDirectory() ? it.toRealPath().listFiles().find { it=~/analysis.tdf_bin/} : it}.collect { it.size() / 10 }.sum().longValue() , 16L << 30) * 1.B } 
    time = { Math.max(raws.size() / 100, 2.0) * 1.h}
    cpus = 10
  }

  withName: RunDiaAnalysis {
    // biggest raw times 4, or 16.GB
    memory = { Math.max(raws.collect { it.isDirectory() ? it.toRealPath().listFiles().find { it=~/analysis.tdf_bin/} : it}.collect { it.size() }.max() * 10, 16L << 30) * 1.B } 
    cpus = 10
  }

  withName: TrainQuantUMS {
    memory = { Math.max(raws.collect { it.isDirectory() ? it.toRealPath().listFiles().find { it=~/analysis.tdf_bin/} : it}.collect { it.size() }.max() * 10, 16L << 30) * 1.B } 
    cpus = 10
  }

  withName: DiaQuantificationReport {
    memory = { Math.max(raws.collect { it.isDirectory() ? it.toRealPath().listFiles().find { it=~/analysis.tdf_bin/} : it}.collect { it.size() }.max() * 10, 16L << 30) * 1.B } 
    cpus = 10
  }

  withName: NonNormalizedDiannReport {
    memory = { Math.max(raws.collect { it.isDirectory() ? it.toRealPath().listFiles().find { it=~/analysis.tdf_bin/} : it}.collect { it.size() }.max() * 10, 16L << 30) * 1.B } 
    cpus = 10
  }

  withName: precursorPlot {
    memory = { Math.max(precursors.size() * 2 , 64L << 30) * 1.B } 
  }
}

workflow {
  output {
    mode = 'copy'
  }
}
