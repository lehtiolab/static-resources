includeConfig "https://raw.githubusercontent.com/lehtiolab/static-resources/main/nf-configs/lehtio.config"

docker {
  enabled = false
}

singularity {
  enabled = true
  runOptions = "-B /mnt/lehtio-rawstorage/nxf_workdir"
}

params {
  cachedir = "/mnt/lehtio-rawstorage/nxf_workdir/__spectronaut_cache"
  batchsize = 2
}

// Always overbook half the node with cpus=16
// so we cannot run multiple processes on a single node.
// This is done because that is incompatible with license, program will crash
// memory may need some trying and tuning, depend on file size, batch size? 
process {
  withName: activateLicense {
    time = 0.1.h
    cpus = 1
  }
  withName: generateLibrary {
    cpus = 16
    memory = {raws.size() > 2 ? 64.GB + 2.GB * raws.size() * task.attempt : 64.GB}
    time = {raws.size() > 2 ? 2.h * raws.size() * task.attempt : 4.h * task.attempt}
  }

  withName: mergePsar {
   // depend on size but 30 libraries TIMS data took only 60GB
    cpus = 16
    memory = 100.GB
  }

  withName: searchDIA {
    cpus = 16
    memory = {raws.size() > 2 ? 64.GB + 2.GB * raws.size() * task.attempt : 64.GB}
    time = {raws.size() > 4 ? 0.25.h * raws.size() * task.attempt : 2.h * task.attempt}
  }

  withName: recalculateSNE {
// totalsize variable can be used here!
    cpus = 16
    memory = 72.GB
  }
  withName: generateConditionFile {
    time = 0.1.h
    cpus = 1
  }
  withName: extractThermoScans {
    time = 0.1.h
    cpus = 1
  }
  withName: getBrukerScanNumbers {
    time = 0.1.h
    cpus = 1
  }
  withName: precursorPlot {
    time = 4.h
    cpus = 1
  }
  withName: proteinPlot {
    time = 4.h
    cpus = 1
  }
  withName: summaryReport {
    time = 0.1.h
    cpus = 1
  }
}
